+            OnlineAudioBufferSettings::kReorderWindowFrames) {
+            return;
+        }
+        if (!force && timed_out) {
+            ESP_LOGW(TAG, "Audio reorder startup timed out with %u packet(s); releasing buffered audio",
+                     static_cast<unsigned>(streaming_reorder_queue_.size()));
+        }
+        expected_streaming_sequence_ = streaming_reorder_queue_.begin()->first;
+        streaming_sequence_initialized_ = true;
+        streaming_reorder_wait_started_at_ = {};
