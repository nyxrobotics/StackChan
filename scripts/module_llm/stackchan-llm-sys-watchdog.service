[Unit]
Description=StackChan llm-sys health watchdog
After=llm-sys.service
Wants=llm-sys.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/stackchan/stackchan_llm_sys_watchdog.py
Restart=always
RestartSec=5s
TimeoutStopSec=10s
User=root

[Install]
WantedBy=multi-user.target
