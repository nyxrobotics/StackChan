[Unit]
Description=StackChan VAD-delimited PCM bridge
After=llm-sys.service llm-audio.service llm-vad.service
Wants=llm-sys.service llm-audio.service llm-vad.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/stackchan/stackchan_vad_pcm_bridge.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
