+    const auto now = std::chrono::steady_clock::now();
+    auto reorder_wait_expired = [this, now]() {
+        if (streaming_reorder_wait_started_at_.time_since_epoch().count() == 0) {
+            streaming_reorder_wait_started_at_ = now;
+            return false;
