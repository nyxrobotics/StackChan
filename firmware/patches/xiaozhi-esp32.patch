+void Application::WaitForConversationRuntime() {
+    ESP_LOGI(TAG, "Waiting for local conversation runtime");
+    int wait_count = 0;
+    while (!hal_bridge::is_conv_ready() && wait_count++ < 1800) {
+        vTaskDelay(pdMS_TO_TICKS(100));
+    }
+    if (hal_bridge::is_conv_ready()) {
+        ESP_LOGI(TAG, "Local conversation runtime ready");
+    } else {
+        ESP_LOGW(TAG, "Local conversation runtime wait timed out");
+    }
+}
